#
# corundum_vck190_build_mac - build + wire the MRMAC companion network for the
# VCK190 (Versal AI Core) Corundum port, 1x100GE CAUI-4 configuration, GTY
# transceivers. This is the GTY sibling of corundum_vpk180_build_mac (VPK180 /
# Versal Premium / GTM); the two differ ONLY in the GT family: GT_TYPE GTY vs
# GTM on mrmac_0 + gtwiz_versal, the gtwiz GTY preset, the glue CONFIG.GT_TYPE
# (which selects IBUFDS_GTE5 / VERSAL_AI_CORE / 80b-128b serdes widths), and the
# GTY serdes pin names (tx_serdes_data/rx_serdes_data vs txdata_in/rxdata_out).
# Everything else (clocking, reset topology, AXIS, PTP, flow control, GND-sweep)
# is identical. Sourced by corundum.tcl inside the corundum_hierarchy instance
# (the VCK190 physical-
# connect switch case).
#
# Block-design automation (apply_bd_automation -rule mrmac) is NOT supported for
# a Versal GT-Wizard MRMAC, so the GT subsystem + AXIS clocking are built as
# explicit BD cells and stitched to the MRMAC hard IP by the mrmac_versal_glue
# RTL cell (versal/mrmac_versal_glue.v). This proc:
#   1. creates mrmac_0 (hard IP, 1x100GE segmented, IS_GT_WIZ_OLD=0 - the NEW
#      GT-Wizard flow), gtwiz_versal (one bonded 4-lane CAUI-4 GT interface), and
#      the mrmac_versal_glue RTL cell. It does NOT create the AXIS/PTP-timestamp
#      MMCM: the 390.625 MHz client clock and 250 MHz ts clock arrive on the
#      hierarchy boundary as mrmac_axis_clk / mrmac_ts_clk, generated by the
#      CONSUMER (see the note at section 1 and projects/ethernet/vck190);
#   2. wires glue <-> {mrmac_0, gtwiz_versal, ethernet_core, board};
#   3. connects the four TX + four RX FLAT serdes-data buses MRMAC<->gtwiz
#      THROUGH the glue (GTY: 80b MRMAC pin <-> 128b gtwiz pin, glue zero-
#      extends TX / low-slices RX - see section 3b);
#   4. ties every unused MRMAC/GT secondary input to 0;
#   5. exposes the two AXI4-Lite register slaves (MRMAC s_axi + GT) and the QSFP
#      GT serial on the corundum_hierarchy boundary.
#
# WHY IS_GT_WIZ_OLD=0 (the NEW flow): the OLD flow exposes typed serdes BUS
# interfaces (gt_{tx,rx}_serdes_interface_*) which gtwiz_versal REJECTS with the
# blocking DRC [gtwiz_versal:1.0-2] ("GT interface must connect to a Versal GT").
# The NEW flow instead exposes FLAT per-lane serdes-data pins that connect to
# gtwiz's channel data pins (through the glue for the GTY width adaptation), is
# DRC-clean, and makes gtwiz the GT reset/clear master (see the glue header).
# The GTM VPK180 sibling validated OLD=0 rc=0 in Vivado 2025.2; the GTY flow is
# structurally identical (same OLD=0 flag, same reset-master topology).
#
# Every pin name/width/interface below was probed in real Vivado 2025.2
# (xcvp1802) against this exact IP config; the reset topology + gt_line_rate
# constant mirror the MRMAC NEW-GT-wizard SEGMENTED example design
# (mrmac_nw_exdes.sv). See memory: [[mrmac-mac-enable-via-axi]],
# [[mrmac-gty-wrapper-vivado-ip]], [[mrmac-100g-gt-topology]],
# [[mrmac-100g-clocking-topology]], [[mrmac-versal-bd-wiring-gotchas]].
#
# The port is intentionally NON-functional standalone: MRMAC has no hardware
# tx/rx-enable pin, so a consumer CPU must drive the s_axi bring-up register
# sequence (RESET/MODE/CONFIG_TX/CONFIG_RX/...) before traffic flows.

proc corundum_vck190_build_mac {} {
  global ad_hdl_dir

  set glue_v "$ad_hdl_dir/library/corundum/versal/mrmac_versal_glue.v"
  if {[lsearch -exact [get_files -quiet -of_objects [get_filesets sources_1]] $glue_v] < 0} {
    add_files -norecurse -fileset sources_1 $glue_v
    update_compile_order -fileset sources_1
  }

  ##########################################################################
  # 1. Companion-network BD cells
  ##########################################################################

  create_bd_cell -type ip -vlnv xilinx.com:ip:mrmac mrmac_0
  set_property -dict [list \
    CONFIG.MRMAC_PRESET_C0 {1x100GE CAUI-4 Wide} \
    CONFIG.MRMAC_MODE_C0 {MAC+PCS} \
    CONFIG.MRMAC_DATA_PATH_INTERFACE_PORT0_C0 {Independent 384b Segmented} \
    CONFIG.MAC_PORT0_RATE_C0 {100GE} \
    CONFIG.GT_TYPE_C0 {GTY} \
    CONFIG.GT_REF_CLK_FREQ_C0 {156.25} \
    CONFIG.MRMAC_IS_GT_WIZ_OLD {0} \
    CONFIG.INCLUDE_AUTO_NEG_LT_LOGIC_C0 {None} \
    CONFIG.MAC_PORT0_TX_FLOW_C0 {1} \
    CONFIG.MAC_PORT0_RX_FLOW_C0 {1} \
    CONFIG.MAC_PORT0_ENABLE_TIME_STAMPING_C0 {1} \
    CONFIG.PORT0_1588v2_Operation_MODE_C0 {2-step} \
    CONFIG.PORT0_1588v2_Clocking_C0 {Ordinary/Boundary Clock} \
    CONFIG.TIMESTAMP_CLK_PERIOD_NS {4.0} \
  ] [get_bd_cells mrmac_0]

  create_bd_cell -type ip -vlnv xilinx.com:ip:gtwiz_versal gtwiz_versal
  set_property -dict [list \
    CONFIG.NO_OF_INTERFACE {1} \
    CONFIG.INTF0_NO_OF_LANES {4} \
    CONFIG.QUAD0_NO_PROT {1} \
    CONFIG.QUAD0_PROT0_LANES {4} \
    CONFIG.QUAD0_PROT0_TX1_EN {true} \
    CONFIG.QUAD0_PROT0_TX2_EN {true} \
    CONFIG.QUAD0_PROT0_TX3_EN {true} \
    CONFIG.QUAD0_PROT0_RX1_EN {true} \
    CONFIG.QUAD0_PROT0_RX2_EN {true} \
    CONFIG.QUAD0_PROT0_RX3_EN {true} \
    CONFIG.QUAD0_TX0_OUTCLK_EN {true} \
    CONFIG.QUAD0_RX0_OUTCLK_EN {true} \
    CONFIG.QUAD0_RX1_OUTCLK_EN {true} \
    CONFIG.QUAD0_RX2_OUTCLK_EN {true} \
    CONFIG.QUAD0_RX3_OUTCLK_EN {true} \
    CONFIG.QUAD0_PROT0_TXMSTCLK {TX0} \
    CONFIG.QUAD0_PROT0_RXMSTCLK {RX0} \
    CONFIG.ENABLE_REG_INTERFACE {true} \
    CONFIG.REG_CONF_INTF {AXI_LITE} \
    CONFIG.GT_TYPE {GTY} \
    CONFIG.INTF0_GT_SETTINGS {LR0_SETTINGS {preset GTY-Ethernet_25G_RAW RXPROGDIV_FREQ_VAL 644.531 RX_REFCLK_FREQUENCY 156.25 TXPROGDIV_FREQ_VAL 644.531 TX_REFCLK_FREQUENCY 156.25}} \
  ] [get_bd_cells gtwiz_versal]


  create_bd_cell -type module -reference mrmac_versal_glue mrmac_versal_glue
  set_property -dict [list \
    CONFIG.GT_TYPE {GTY} \
    CONFIG.MRMAC_SERDES_W {80} \
    CONFIG.GT_CH_W {128} \
    CONFIG.RX_PER_LANE_CLK {1} \
  ] [get_bd_cells mrmac_versal_glue]

  ##########################################################################
  # 2. Board clocks / resets into the companion network
  ##########################################################################

  ad_connect mrmac_versal_glue/gt_ref_clk_p gt_ref_clk_p
  ad_connect mrmac_versal_glue/gt_ref_clk_n gt_ref_clk_n
  connect_bd_net [get_bd_pins mrmac_versal_glue/gt_refclk_out] \
                 [get_bd_pins gtwiz_versal/QUAD0_GTREFCLK0]

  ad_connect mrmac_versal_glue/ptp_refclk_bufg ptp_refclk_bufg

  connect_bd_net [get_bd_pins gt_freerun_clk] \
                 [get_bd_pins gtwiz_versal/gtwiz_freerun_clk] \
                 [get_bd_pins mrmac_0/s_axi_aclk]

  ad_connect mrmac_versal_glue/axis_clk_in mrmac_axis_clk
  ad_connect mrmac_versal_glue/ts_clk_in   mrmac_ts_clk

  # Board reset (active-low): glue reset gen + both AXI-Lite reset inputs.
  ad_connect mrmac_versal_glue/pl_resetn mac_resetn
  ad_connect mrmac_0/s_axi_aresetn mac_resetn
  ad_connect gtwiz_versal/QUAD0_s_axi_lite_resetn mac_resetn

  ##########################################################################
  # 3. glue <-> gtwiz_versal (single bonded CAUI-4 interface, scalar pins)
  ##########################################################################

  connect_bd_net [get_bd_pins gtwiz_versal/QUAD0_TX0_outclk] \
                 [get_bd_pins mrmac_versal_glue/gt_tx_outclk]
  connect_bd_net [get_bd_pins gtwiz_versal/QUAD0_RX0_outclk] \
                 [get_bd_pins mrmac_versal_glue/gt_rx_outclk]
  for {set ch 1} {$ch < 4} {incr ch} {
    connect_bd_net [get_bd_pins gtwiz_versal/QUAD0_RX${ch}_outclk] \
                   [get_bd_pins mrmac_versal_glue/gt_rx_outclk_${ch}]
  }

  for {set ch 0} {$ch < 4} {incr ch} {
    connect_bd_net [get_bd_pins mrmac_versal_glue/gt_tx_usrclk_${ch}] \
                   [get_bd_pins gtwiz_versal/QUAD0_TX${ch}_usrclk]
    connect_bd_net [get_bd_pins mrmac_versal_glue/gt_rx_usrclk_${ch}] \
                   [get_bd_pins gtwiz_versal/QUAD0_RX${ch}_usrclk]
  }

  connect_bd_net [get_bd_pins gtwiz_versal/INTF0_TX_clr_out]       [get_bd_pins mrmac_versal_glue/gt_tx_clr]
  connect_bd_net [get_bd_pins gtwiz_versal/INTF0_TX_clrb_leaf_out] [get_bd_pins mrmac_versal_glue/gt_tx_clrb_leaf]
  connect_bd_net [get_bd_pins gtwiz_versal/INTF0_RX_clr_out]       [get_bd_pins mrmac_versal_glue/gt_rx_clr]
  connect_bd_net [get_bd_pins gtwiz_versal/INTF0_RX_clrb_leaf_out] [get_bd_pins mrmac_versal_glue/gt_rx_clrb_leaf]

  connect_bd_net [get_bd_pins gtwiz_versal/INTF0_rst_tx_done_out] [get_bd_pins mrmac_versal_glue/gt_rst_tx_done]
  connect_bd_net [get_bd_pins gtwiz_versal/INTF0_rst_rx_done_out] [get_bd_pins mrmac_versal_glue/gt_rst_rx_done]

  connect_bd_net [get_bd_pins mrmac_versal_glue/gt_rst_all] \
                 [get_bd_pins gtwiz_versal/INTF0_rst_all_in]

  ##########################################################################
  # 3b. FLAT serdes-data connect (MRMAC <-> gtwiz) THROUGH the glue, four TX +
  #     four RX lanes.
  #     NEW flow + GTY: the MRMAC exposes flat per-lane serdes-data pins named
  #     tx_serdes_data${n} [79:0] (output) / rx_serdes_data${n} [79:0] (input).
  #     gtwiz's per-channel data pins INTF0_{TX,RX}{n}_ch_{tx,rx}data are [127:0]
  #     under GTY. The widths differ (80 vs 128), so this is routed THROUGH the
  #     glue, which zero-extends TX (80->128, drives every gtwiz input bit) and
  #     takes the low 80 of RX (128->80). This avoids a partial connect_bd_net
  #     that would leave gtwiz's upper TX-input bits undriven (blocking DRC).
  #     Confirmed in the VCK190 mrmac_0 example: mrmac tx/rx_serdes_data=[79:0];
  #     gtwiz ch_{tx,rx}data=[127:0]. Rate is not a data-pin member; it is driven
  #     by a constant in section 8. (The glue's mrmac-side ports keep the generic
  #     names mrmac_txdata_in_${n}/mrmac_rxdata_out_${n} regardless of family; only
  #     the MRMAC IP pin names differ GTM txdata_in/rxdata_out vs GTY
  #     tx_serdes_data/rx_serdes_data.)
  ##########################################################################
  for {set n 0} {$n < 4} {incr n} {
    # TX: mrmac tx_serdes_data -> glue (zero-extend) -> gtwiz ch_txdata
    connect_bd_net [get_bd_pins mrmac_0/tx_serdes_data${n}] \
                   [get_bd_pins mrmac_versal_glue/mrmac_txdata_in_${n}]
    connect_bd_net [get_bd_pins mrmac_versal_glue/gt_ch_txdata_${n}] \
                   [get_bd_pins gtwiz_versal/INTF0_TX${n}_ch_txdata]
    # RX: gtwiz ch_rxdata -> glue (low-slice) -> mrmac rx_serdes_data
    connect_bd_net [get_bd_pins gtwiz_versal/INTF0_RX${n}_ch_rxdata] \
                   [get_bd_pins mrmac_versal_glue/gt_ch_rxdata_${n}]
    connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_rxdata_out_${n}] \
                   [get_bd_pins mrmac_0/rx_serdes_data${n}]
  }

  ##########################################################################
  # 4. glue <-> mrmac_0 clocks / resets (all [3:0] vectors - MRMAC clock/reset
  #    pins are per-GT-lane, independent of MAC port count).
  ##########################################################################
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_core_clk]      [get_bd_pins mrmac_0/tx_core_clk]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_rx_core_clk]      [get_bd_pins mrmac_0/rx_core_clk]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_rx_serdes_clk]    [get_bd_pins mrmac_0/rx_serdes_clk]
  # segmented 100G REQUIRES the alt-serdes clocks (MBUFG O2); 4x25 left them open
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_alt_serdes_clk] [get_bd_pins mrmac_0/tx_alt_serdes_clk]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_rx_alt_serdes_clk] [get_bd_pins mrmac_0/rx_alt_serdes_clk]
  # one AXIS clock net feeds mrmac_0 tx+rx axi clk ([3:0])
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_axi_clk] \
                 [get_bd_pins mrmac_0/tx_axi_clk] \
                 [get_bd_pins mrmac_0/rx_axi_clk]
  # PTP timestamp clock ([3:0]) feeds mrmac_0 tx+rx ts clk (250 MHz via glue)
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ts_clk] \
                 [get_bd_pins mrmac_0/tx_ts_clk] \
                 [get_bd_pins mrmac_0/rx_ts_clk]

  # Flex-interface clock ([3:0]) -> mrmac_0 tx+rx flexif clk. Unused in MAC+PCS
  # AXIS mode, but a BD clock pin MUST have a real clock source or [BD 41-758];
  # the glue drives it from the AXIS clock (the flex datapath stays inactive).
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_flexif_clk] \
                 [get_bd_pins mrmac_0/tx_flexif_clk] \
                 [get_bd_pins mrmac_0/rx_flexif_clk]

  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_core_reset]   [get_bd_pins mrmac_0/tx_core_reset]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_rx_core_reset]   [get_bd_pins mrmac_0/rx_core_reset]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_serdes_reset] [get_bd_pins mrmac_0/tx_serdes_reset]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_rx_serdes_reset] [get_bd_pins mrmac_0/rx_serdes_reset]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_flexif_reset]    [get_bd_pins mrmac_0/rx_flexif_reset]

  ##########################################################################
  # 4b. shim (ethernet_core) AXIS-domain clock + reset. At PORT_COUNT=1 the shim
  #     mrmac_tx/rx_axi_clk + mrmac_tx/rx_reset_in are 1-bit, so they take the
  #     scalar AXIS clock (the mrmac_axis_clk boundary pin, same net as the glue's
  #     axis_clk_in) and the glue's SCALAR shim_axi_reset (~pl_resetn). mrmac_0
  #     has no AXI reset pin; this reset drives only the shim FIFOs.
  ##########################################################################
  connect_bd_net [get_bd_pins mrmac_axis_clk] \
                 [get_bd_pins ethernet_core/mrmac_tx_axi_clk] \
                 [get_bd_pins ethernet_core/mrmac_rx_axi_clk]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_axi_reset] \
                 [get_bd_pins ethernet_core/mrmac_tx_reset_in] \
                 [get_bd_pins ethernet_core/mrmac_rx_reset_in]

  ##########################################################################
  # 5. glue <-> mrmac_0 AXIS (one 100G port as six 64b segments + one scalar
  #    handshake). Segments 0..5; tdata[63:0], tkeep_user[10:0] each.
  ##########################################################################
  for {set s 0} {$s < 6} {incr s} {
    connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_axis_tdata${s}]      [get_bd_pins mrmac_0/tx_axis_tdata${s}]
    connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_axis_tkeep_user${s}] [get_bd_pins mrmac_0/tx_axis_tkeep_user${s}]
    connect_bd_net [get_bd_pins mrmac_0/rx_axis_tdata${s}]      [get_bd_pins mrmac_versal_glue/mrmac_rx_axis_tdata${s}]
    connect_bd_net [get_bd_pins mrmac_0/rx_axis_tkeep_user${s}] [get_bd_pins mrmac_versal_glue/mrmac_rx_axis_tkeep_user${s}]
  }
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_axis_tvalid_0] [get_bd_pins mrmac_0/tx_axis_tvalid_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_axis_tlast_0]  [get_bd_pins mrmac_0/tx_axis_tlast_0]
  connect_bd_net [get_bd_pins mrmac_0/tx_axis_tready_0]                 [get_bd_pins mrmac_versal_glue/mrmac_tx_axis_tready_0]

  connect_bd_net [get_bd_pins mrmac_0/rx_axis_tvalid_0] [get_bd_pins mrmac_versal_glue/mrmac_rx_axis_tvalid_0]
  connect_bd_net [get_bd_pins mrmac_0/rx_axis_tlast_0]  [get_bd_pins mrmac_versal_glue/mrmac_rx_axis_tlast_0]
  connect_bd_net [get_bd_pins mrmac_0/stat_rx_status_0] [get_bd_pins mrmac_versal_glue/mrmac_stat_rx_status_0]

  ##########################################################################
  # 5b. glue <-> mrmac_0 PTP (single port, _0 suffix). Pure 1:1 whole-pin
  #     connects; the 55<->80b format conversion + sync FSM live in the shim.
  ##########################################################################
  # RX timestamp: mrmac -> glue
  connect_bd_net [get_bd_pins mrmac_0/rx_ptp_tstamp_out_0]        [get_bd_pins mrmac_versal_glue/mrmac_rx_ptp_tstamp_0]
  # TX op / tag: glue -> mrmac
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_ptp_1588op_0]     [get_bd_pins mrmac_0/tx_ptp_1588op_in_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_tx_ptp_tag_field_0]  [get_bd_pins mrmac_0/tx_ptp_tag_field_in_0]
  # TX completion: mrmac -> glue
  connect_bd_net [get_bd_pins mrmac_0/tx_ptp_tstamp_out_0]        [get_bd_pins mrmac_versal_glue/mrmac_tx_ptp_tstamp_0]
  connect_bd_net [get_bd_pins mrmac_0/tx_ptp_tstamp_tag_out_0]    [get_bd_pins mrmac_versal_glue/mrmac_tx_ptp_tstamp_tag_0]
  connect_bd_net [get_bd_pins mrmac_0/tx_ptp_tstamp_valid_out_0]  [get_bd_pins mrmac_versal_glue/mrmac_tx_ptp_tstamp_valid_0]
  # System-timer discipline: glue -> mrmac
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_tx_ptp_systemtimer_0]  [get_bd_pins mrmac_0/ctl_tx_ptp_systemtimer_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_tx_ptp_st_sync_0]      [get_bd_pins mrmac_0/ctl_tx_ptp_st_sync_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_tx_ptp_st_overwrite_0] [get_bd_pins mrmac_0/ctl_tx_ptp_st_overwrite_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_rx_ptp_systemtimer_0]  [get_bd_pins mrmac_0/ctl_rx_ptp_systemtimer_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_rx_ptp_st_sync_0]      [get_bd_pins mrmac_0/ctl_rx_ptp_st_sync_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_rx_ptp_st_overwrite_0] [get_bd_pins mrmac_0/ctl_rx_ptp_st_overwrite_0]

  ##########################################################################
  # 5c. glue <-> mrmac_0 flow control (pause), single port, _0 suffix. Each is
  #     a 9-bit {lfc, pfc} vector (bit 8 = link/global pause = lfc, bits [7:0] =
  #     the 8 PFC priority classes = pfc), mirroring the CMAC contract. TX pause
  #     quanta / refresh timers are NOT pins here - they are set via the MRMAC
  #     s_axi bring-up (the AXI-enable model), unlike the CMAC which took them as
  #     pins. ctl_tx_resend_pause_0 is left undriven -> GND-swept in section 7.
  ##########################################################################
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_tx_pause_enable_0] [get_bd_pins mrmac_0/ctl_tx_pause_enable_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_tx_pause_req_0]    [get_bd_pins mrmac_0/ctl_tx_pause_req_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_rx_pause_enable_0] [get_bd_pins mrmac_0/ctl_rx_pause_enable_0]
  connect_bd_net [get_bd_pins mrmac_versal_glue/mrmac_ctl_rx_pause_ack_0]    [get_bd_pins mrmac_0/ctl_rx_pause_ack_0]
  connect_bd_net [get_bd_pins mrmac_0/stat_rx_pause_req_0]                   [get_bd_pins mrmac_versal_glue/mrmac_stat_rx_pause_req_0]

  ##########################################################################
  # 6. glue <-> ethernet_core (the ethernet_vpk180 shim). One 100G port: the
  #    packed vectors are exactly one segmented word (384b data + 66b
  #    tkeep_user) with a single handshake.
  ##########################################################################
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_axis_tdata]      [get_bd_pins mrmac_versal_glue/shim_tx_axis_tdata]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_axis_tkeep_user] [get_bd_pins mrmac_versal_glue/shim_tx_axis_tkeep_user]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_axis_tvalid]     [get_bd_pins mrmac_versal_glue/shim_tx_axis_tvalid]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_axis_tlast]      [get_bd_pins mrmac_versal_glue/shim_tx_axis_tlast]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_tx_axis_tready]  [get_bd_pins ethernet_core/mrmac_tx_axis_tready]

  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_rx_axis_tdata]      [get_bd_pins ethernet_core/mrmac_rx_axis_tdata]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_rx_axis_tkeep_user] [get_bd_pins ethernet_core/mrmac_rx_axis_tkeep_user]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_rx_axis_tvalid]     [get_bd_pins ethernet_core/mrmac_rx_axis_tvalid]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_rx_axis_tlast]      [get_bd_pins ethernet_core/mrmac_rx_axis_tlast]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_stat_rx_status]     [get_bd_pins ethernet_core/mrmac_stat_rx_status]

  ##########################################################################
  # 6b. glue <-> ethernet_core PTP (packed [W-1:0] vectors; the shim does the
  #     format conversion + sync FSM, the glue only re-packs).
  ##########################################################################
  # RX timestamp: glue -> shim
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_rx_ptp_tstamp]        [get_bd_pins ethernet_core/mrmac_rx_ptp_tstamp]
  # TX op / tag: shim -> glue
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_ptp_1588op]           [get_bd_pins mrmac_versal_glue/shim_tx_ptp_1588op]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_ptp_tag_field]        [get_bd_pins mrmac_versal_glue/shim_tx_ptp_tag_field]
  # TX completion: glue -> shim
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_tx_ptp_tstamp]        [get_bd_pins ethernet_core/mrmac_tx_ptp_tstamp]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_tx_ptp_tstamp_tag]    [get_bd_pins ethernet_core/mrmac_tx_ptp_tstamp_tag]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_tx_ptp_tstamp_valid]  [get_bd_pins ethernet_core/mrmac_tx_ptp_tstamp_valid]
  # System-timer discipline: shim -> glue
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_ptp_systemtimer]      [get_bd_pins mrmac_versal_glue/shim_tx_ptp_systemtimer]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_ptp_st_sync]          [get_bd_pins mrmac_versal_glue/shim_tx_ptp_st_sync]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_tx_ptp_st_overwrite]     [get_bd_pins mrmac_versal_glue/shim_tx_ptp_st_overwrite]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_rx_ptp_systemtimer]      [get_bd_pins mrmac_versal_glue/shim_rx_ptp_systemtimer]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_rx_ptp_st_sync]          [get_bd_pins mrmac_versal_glue/shim_rx_ptp_st_sync]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_rx_ptp_st_overwrite]     [get_bd_pins mrmac_versal_glue/shim_rx_ptp_st_overwrite]

  ##########################################################################
  # 6c. glue <-> ethernet_core flow control (pause). Packed 9-bit {lfc, pfc}
  #     vectors; the shim (mrmac_gty_wrapper) forms/splits them from corundum's
  #     tx/rx_lfc_* + tx/rx_pfc_* sideband. Same TX/RX AXIS clock domain end to
  #     end -> plain wires, no CDC (mirrors the CMAC wrapper).
  ##########################################################################
  connect_bd_net [get_bd_pins ethernet_core/mrmac_ctl_tx_pause_enable] [get_bd_pins mrmac_versal_glue/shim_ctl_tx_pause_enable]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_ctl_tx_pause_req]    [get_bd_pins mrmac_versal_glue/shim_ctl_tx_pause_req]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_ctl_rx_pause_enable] [get_bd_pins mrmac_versal_glue/shim_ctl_rx_pause_enable]
  connect_bd_net [get_bd_pins ethernet_core/mrmac_ctl_rx_pause_ack]    [get_bd_pins mrmac_versal_glue/shim_ctl_rx_pause_ack]
  connect_bd_net [get_bd_pins mrmac_versal_glue/shim_stat_rx_pause_req] [get_bd_pins ethernet_core/mrmac_stat_rx_pause_req]

  ##########################################################################
  # 7. Tie every UNUSED MRMAC input to 0. The 1x100GE segmented MRMAC still
  #    physically exposes all 4 control ports (ctl_tx/rx_port0..3) + 8 flex
  #    lanes + the unused PTP members even though only port 0 is an active MAC,
  #    so a hand list is fragile. Instead: GND-sweep every MRMAC INPUT that is
  #    (a) not already driven above and (b) not a member of the s_axi interface
  #    (whose interface-net members read back as "no net" and must NOT be
  #    re-tied). connect_bd_net-driven pins report a net and are skipped.
  #    GTY flow: the serdes is FLAT data pins - rx_serdes_data* are MRMAC inputs
  #    driven in section 3b (report a net -> skipped) and tx_serdes_data* are MRMAC
  #    outputs (excluded by the DIR filter), so no serdes interface exclusion is
  #    needed. s_axi is the only remaining interface pin on mrmac_0.
  ##########################################################################
  set _excl [dict create]
  foreach _mp [get_bd_pins -quiet -of [get_bd_intf_pins -quiet mrmac_0/s_axi]] {
    dict set _excl $_mp 1
  }
  foreach _p [lsort [get_bd_pins -quiet -of [get_bd_cells mrmac_0]]] {
    if {[get_property DIR $_p] ne "I"} continue
    if {[dict exists $_excl $_p]} continue
    if {[llength [get_bd_nets -quiet -of $_p]]} continue
    set _nm [lindex [split $_p /] end]
    ad_connect mrmac_0/$_nm GND
  }

  ##########################################################################
  # 8. GT (gtwiz) secondary inputs -> constants.
  ##########################################################################
  ad_ip_instance xlconstant gt_line_rate [list \
    CONST_WIDTH 8 \
    CONST_VAL 2 \
  ]
  for {set ch 0} {$ch < 4} {incr ch} {
    connect_bd_net [get_bd_pins gt_line_rate/dout] [get_bd_pins gtwiz_versal/INTF0_TX${ch}_ch_txrate]
    connect_bd_net [get_bd_pins gt_line_rate/dout] [get_bd_pins gtwiz_versal/INTF0_RX${ch}_ch_rxrate]
  }
  # Datapath / pll-and-datapath resets held 0 (bring-up via INTF0_rst_all only).
  ad_connect gtwiz_versal/INTF0_rst_tx_datapath_in          GND
  ad_connect gtwiz_versal/INTF0_rst_rx_datapath_in          GND
  ad_connect gtwiz_versal/INTF0_rst_tx_pll_and_datapath_in  GND
  ad_connect gtwiz_versal/INTF0_rst_rx_pll_and_datapath_in  GND
  # GPIO input tied off (no per-channel loopback pins exist in this bonded config).
  ad_connect gtwiz_versal/QUAD0_gpi GND

  ##########################################################################
  # 9. Boundary: QSFP GT serial + the two AXI4-Lite register slaves
  ##########################################################################
  ad_connect gtwiz_versal/Quad0_GT_Serial qsfp_serial
  ad_connect mrmac_0/s_axi               s_axi_mac
  ad_connect gtwiz_versal/Quad0_AXI_LITE s_axi_gt
}
