<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory "./" :>
<: setFileName [ttcl_add $ComponentName "_constr"] :>
<: setFileExtension ".xdc" :>
<: setFileProcessingOrder late :>
<: set lvds_cmos_n [getBooleanValue "LVDS_CMOS_N"] :>

set up_clk [get_clocks -of_objects [get_ports s_axi_aclk]]

set_false_path -quiet \
        -from $up_clk \
        -to [get_cells -quiet -hier -filter {name =~ *i_adc_channel/pattern_reg*}]

<: if { $lvds_cmos_n } { :>

  set_false_path -quiet \
        -from $up_clk \
        -to [get_cells -quiet -hier -filter {name =~ *packet_format_reg* && IS_SEQUENTIAL}]

  set_false_path -quiet \
        -from $up_clk \
        -to [get_cells -quiet -hier -filter {name =~ *ch_*_base_reg* && IS_SEQUENTIAL}]

  set_false_path -quiet \
        -from [get_cells -hier -filter {name =~ *packet_format_reg* && IS_SEQUENTIAL}] \
        -to [get_cells -quiet -hier -filter {name =~ *packet_cnt_length_reg* && IS_SEQUENTIAL}]

  # scko/fast_clk -> adc_clk CDC: rx_data shift registers and IDDR into adc_data_init
  # capture_complete gates the latch so this crossing is safe
  set_max_delay -datapath_only \
        -from [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/rx_data_pos_reg* && IS_SEQUENTIAL}] \
        -to   [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/genblk3*.adc_data_init_reg* && IS_SEQUENTIAL}] 5.333

  set_max_delay -datapath_only \
        -from [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/rx_data_neg_reg* && IS_SEQUENTIAL}] \
        -to   [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/genblk3*.adc_data_init_reg* && IS_SEQUENTIAL}] 5.333

  set_max_delay -datapath_only \
        -from [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/i_rx/i_rx_data_iddr* && IS_SEQUENTIAL}] \
        -to   [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/genblk3*.adc_data_init_reg* && IS_SEQUENTIAL}] 5.333

  # adc_data_init -> adc_data_store latch (both clocked by adc_clk, safe relaxed path)
  set_max_delay -datapath_only \
        -from [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/genblk3*.adc_data_init_reg* && IS_SEQUENTIAL}] \
        -to   [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/adc_data_store_reg* && IS_SEQUENTIAL}] 5.333

  # adc_valid_init pipeline (scko -> adc_clk)
  set_max_delay -datapath_only \
        -from [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/adc_valid_init_reg* && IS_SEQUENTIAL}] \
        -to   [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/adc_valid_init_d_reg* && IS_SEQUENTIAL}] 5.333

  # NSSI: fast_clk -> adc_clk CDC: ISERDES output into rx_data shift register
  set_max_delay -datapath_only \
        -from [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/i_adc_data* && IS_SEQUENTIAL}] \
        -to   [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/rx_data_reg* && IS_SEQUENTIAL}] 5.333

  # NSSI: adc_clk internal path: rx_data_d -> adc_data_store (written via ch_valid_dn gate)
  set_max_delay -datapath_only \
        -from [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/rx_data_d_reg* && IS_SEQUENTIAL}] \
        -to   [get_cells -quiet -hier -filter {name =~ *i_ad4858_lvds_interface/adc_data_store_reg* && IS_SEQUENTIAL}] 5.333


<: } else { :>

  # asynchronous reset while destination clock is not active
  set_max_delay -datapath_only \
        -from [get_cells -hier -filter {name =~ *start_transfer_reg*}] \
        -to [get_cells -hier -filter {name =~ *new_transfer_*reg* && IS_SEQUENTIAL}] 20.0

  # asynchronous reset while destination clock is not active
  set_false_path -quiet \
        -from [get_cells -hier -filter {name =~ *start_transfer_reg* && IS_SEQUENTIAL}] \
        -to [get_cells -hier -filter {name =~ *capture_cnt_reg* && IS_SEQUENTIAL}]

  # asynchronous reset while destination clock is not active
  set_false_path -quiet \
        -from [get_cells -hier -filter {name =~ *start_transfer_reg* && IS_SEQUENTIAL}] \
        -to [get_cells -hier -filter {name =~ *adc_captured_reg* && IS_SEQUENTIAL}]

  set_max_delay -quiet \
        -from [get_cells -hier -filter {name =~ *adc_data_init_reg*}] \
        -to [get_cells -hier -filter {name =~ *adc_data_store_reg*}] 20.0

  # constant value after config
  set_false_path -quiet \
        -from [get_cells -hier -filter {name =~ *i_ad485x_cmos_interface/packet_format_reg*}]  \
        -to [get_cells -hier -filter {name =~ *capture_cnt_reg* && IS_SEQUENTIAL}]

  # asynchronous reset while destination clock is not active
  set_false_path -quiet \
        -from [get_cells -hier -filter {name =~ *i_ad485x_cmos_interface/packet_format_reg*}]  \
        -to [get_cells -hier -filter {name =~ *adc_captured_reg* && IS_SEQUENTIAL}]

  set_max_delay -quiet \
        -from [get_cells -hier -filter {name =~ *adc_ch*_shift_reg*}] \
        -to [get_cells -hier -filter {name =~ *adc_data_store_reg*}] 20.0

<: } :>
