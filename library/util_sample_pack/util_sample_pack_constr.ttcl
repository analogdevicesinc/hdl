# Follows the constraint scripts of the Vivado XPM macros: xpm_cdc_gray for
# the pointers, xpm_fifo_rst for the distributed RAM, xpm_cdc_single and
# xpm_cdc_async_rst for the level and reset synchronizers.

<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory "./" :>
<: setFileName [ttcl_add $ComponentName "_constr"] :>
<: setFileExtension ".xdc" :>
<: setFileProcessingOrder late :>
<: set join_fifo [getBooleanValue "JOIN_FIFO_ENABLE"] :>
<: set num_ch [getIntValue "NUM_CH"] :>
<: set config_cdc [expr {[getBooleanValue "CONFIG_CDC"] || $join_fifo}] :>
<: if {$join_fifo} { :>

set out_clk    [get_clocks -of_objects [get_ports clk]]
set out_period [get_property -min PERIOD $out_clk]

set_property ASYNC_REG TRUE \
  [get_cells -hier -filter {NAME =~ *i_join_fifo/*cdc_sync_stage*_reg* && IS_SEQUENTIAL}]

set_false_path -through [get_ports async_resetn]

set_false_path -to [get_cells -hier -filter {IS_SEQUENTIAL && \
  (NAME =~ *i_join_fifo/i_reset_sync/cdc_sync_stage1_reg* || \
   NAME =~ *i_join_fifo/*.i_reset_sync/cdc_sync_stage1_reg* || \
   NAME =~ *i_join_fifo/*i_overflow_sync/*cdc_sync_stage1_reg* || \
   NAME =~ *i_join_fifo/*i_xfer_sync/cdc_sync_stage1_reg*)}]
<: for {set i 0} {$i < $num_ch} {incr i} { :>

# channel <=: $i :>
set ch_clk    [get_clocks -of_objects [get_ports clk_<=: $i :>]]
set ch_period [get_property -min PERIOD $ch_clk]
set skew      [expr {min($ch_period, $out_period)}]

# the sources are taken from the fan-in, as synthesis may merge equal pointers
set w_dst [get_cells -hier -filter {NAME =~ *i_join_fifo/g_ch?<=: $i :>?.i_w_gray_sync/cdc_sync_stage1_reg* && IS_SEQUENTIAL}]
set w_src [get_cells -of_objects [all_fanin -flat -startpoints_only [get_pins -of_objects $w_dst -filter {REF_PIN_NAME == D}]]]
set_max_delay -datapath_only -from $w_src -to $w_dst $ch_period
set_bus_skew -from $w_src -to $w_dst $skew

set r_dst [get_cells -hier -filter {NAME =~ *i_join_fifo/g_ch?<=: $i :>?.i_r_gray_sync/cdc_sync_stage1_reg* && IS_SEQUENTIAL}]
set r_src [get_cells -of_objects [all_fanin -flat -startpoints_only [get_pins -of_objects $r_dst -filter {REF_PIN_NAME == D}]]]
set_max_delay -datapath_only -from $r_src -to $r_dst $out_period
set_bus_skew -from $r_src -to $r_dst $skew

set_max_delay -datapath_only \
  -from [get_cells -hier -filter {NAME =~ *i_join_fifo/g_ch?<=: $i :>?.mem_reg* && IS_SEQUENTIAL}] \
  -to $out_clk $ch_period
<: } :>
<: } :>
<: if {$config_cdc} { :>

set_property ASYNC_REG TRUE \
  [get_cells -hier -filter {NAME =~ *i_sample_pack/i_config_sync/cdc_sync_stage*_reg* && IS_SEQUENTIAL}]

set_false_path -to [get_cells -hier -filter {NAME =~ *i_sample_pack/i_config_sync/cdc_sync_stage1_reg* && IS_SEQUENTIAL}]
<: } :>
