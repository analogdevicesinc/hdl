	-DIRECTION OUTPUT

# H16 FMC_LA11_P
set_io -port_name {TXD[0]}  \
	-pin_name B26                   \
	-fixed true                     \
	-io_std LVDS25                  \
	-DIRECTION OUTPUT

# H17 FMC_LA11_N
set_io -port_name {TXD_N[0]}  \
